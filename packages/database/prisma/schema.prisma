generator client {
  provider = "prisma-client"
  output = "../generated/client"
}
datasource db {
  provider = "postgresql"
}
enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
}
enum Theme {
  system
  light
  dark
}
model User {
  id String @id
  name String
  email String @unique
  emailVerified Boolean @default(false)
  image String?
  status UserStatus @default(INVITED)
  isAdmin Boolean @default(false)
  theme Theme @default(system)
  authVersion Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions Session[]
  accounts Account[]
  invitations Invitation[]
  memberships DepartmentMembership[]
  createdTickets Ticket[]
  ticketAssignments TicketAssignee[] @relation("Assignee")
  assignedTickets TicketAssignee[] @relation("AssignedBy")
  ticketActivities TicketActivity[]
  ticketAttachments TicketAttachment[]
  ticketMessages TicketMessage[]
}
model Session {
  id String @id
  authVersion Int @default(0)
  expiresAt DateTime
  token String @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}
model Account {
  id String @id
  accountId String
  providerId String
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken String?
  refreshToken String?
  idToken String?
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  scope String?
  password String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([providerId, accountId])
  @@index([userId])
}
model Verification {
  id String @id
  identifier String
  value String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([identifier])
}
model Invitation {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String @unique
  expiresAt DateTime
  usedAt DateTime?
  revokedAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId])
}
model Department {
  id String @id @default(uuid())
  name String
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  memberships DepartmentMembership[]
  originatedTickets Ticket[] @relation("OriginDepartment")
  tickets Ticket[] @relation("HandlingDepartment")
}
model DepartmentMembership {
  userId String
  departmentId String
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  @@id([userId, departmentId])
  @@index([departmentId])
}
model RateLimit {
  id String @id @default(uuid())
  key String @unique
  count Int
  lastRequest BigInt
}

enum TicketStatus {
  OPEN
  PENDING
  IN_PROGRESS
  DONE
  REVIEW
  BLOCKED
  CLOSED
}
enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}
enum RequestedFor {
  SELF
  OTHER
}
enum ActivityVisibility {
  SHARED
  INTERNAL
}
enum AttachmentStatus {
  PENDING_UPLOAD
  AVAILABLE
  FAILED
  PENDING_DELETION
}
model Ticket {
  id String @id @default(uuid()) @db.Uuid
  number Int @unique @default(autoincrement())
  title String @db.VarChar(150)
  description String
  createdById String
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)
  requestedFor RequestedFor
  requesterName String @db.VarChar(150)
  originDepartmentId String
  originDepartment Department @relation("OriginDepartment", fields: [originDepartmentId], references: [id], onDelete: Restrict)
  originDepartmentName String
  departmentId String
  department Department @relation("HandlingDepartment", fields: [departmentId], references: [id], onDelete: Restrict)
  status TicketStatus @default(OPEN)
  priority TicketPriority @default(NORMAL)
  dueDate DateTime? @db.Date
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  assignees TicketAssignee[]
  activities TicketActivity[]
  attachments TicketAttachment[]
  messages TicketMessage[]
  outboxEvents OutboxEvent[]
  @@index([createdById, createdAt, id])
  @@index([departmentId, status, createdAt, id])
  @@index([departmentId, dueDate, id])
  @@index([originDepartmentId])
}
model TicketAssignee {
  ticketId String @db.Uuid
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  userId String
  user User @relation("Assignee", fields: [userId], references: [id], onDelete: Restrict)
  assignedById String
  assignedBy User @relation("AssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)
  assignedAt DateTime @default(now()) @db.Timestamptz(3)
  @@id([ticketId, userId])
  @@index([userId, ticketId])
  @@index([assignedById])
}
model TicketActivity {
  id String @id @default(uuid()) @db.Uuid
  ticketId String @db.Uuid
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  authorId String
  author User @relation(fields: [authorId], references: [id], onDelete: Restrict)
  action String @db.VarChar(100)
  ticketVersion Int
  changes Json
  reason String?
  visibility ActivityVisibility
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([ticketId, createdAt, id])
  @@index([ticketId, visibility, createdAt, id])
  @@index([authorId])
}
model TicketAttachment {
  id String @id @default(uuid()) @db.Uuid
  ticketId String @db.Uuid
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  messageId String? @db.Uuid
  message TicketMessage? @relation(fields: [messageId, ticketId], references: [id, ticketId], onDelete: Restrict, onUpdate: Restrict)
  removedAt DateTime? @db.Timestamptz(3)
  uploadedById String
  uploadedBy User @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  originalName String @db.VarChar(255)
  objectKey String @unique
  mimeType String @db.VarChar(150)
  size Int
  status AttachmentStatus @default(PENDING_UPLOAD)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  @@index([ticketId, status, createdAt, id])
  @@index([uploadedById])
  @@index([messageId, removedAt, createdAt, id])
}
model TicketMessage {
  id String @id @default(uuid()) @db.Uuid
  ticketId String @db.Uuid
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  authorId String
  author User @relation(fields: [authorId], references: [id], onDelete: Restrict)
  markdown String
  visibility ActivityVisibility
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)
  attachments TicketAttachment[]
  revisions TicketMessageRevision[]
  @@unique([id, ticketId])
  @@index([ticketId, createdAt, id])
  @@index([ticketId, visibility, createdAt, id])
  @@index([authorId])
}
model TicketMessageRevision {
  id String @id @default(uuid()) @db.Uuid
  messageId String @db.Uuid
  message TicketMessage @relation(fields: [messageId], references: [id], onDelete: Restrict)
  version Int
  markdown String
  // Immutable [{ id, originalName }] snapshot, validated by the SQL migration.
  // Download eligibility always comes from the current attachment/message.
  attachments Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@unique([messageId, version])
}
model OutboxEvent {
  id String @id @default(uuid()) @db.Uuid
  ticketId String @db.Uuid
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  type String @db.VarChar(100)
  contractVersion Int
  payload Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([ticketId, createdAt, id])
}
