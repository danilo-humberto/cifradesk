generator client {
  provider = "prisma-client"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

// Modelo exclusivamente para verificar geração, sem tabela física ou migration.
// Substituir pelo domínio aprovado na etapa 2, antes de qualquer migration.
model FoundationProbe {
  id String @id
  @@ignore
}
