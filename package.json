{
  "name": "cifradesk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24.22.3 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @cifradesk/web dev",
    "build": "pnpm --filter @cifradesk/web build && pnpm --filter @cifradesk/worker build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p tsconfig.tools.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter @cifradesk/database generate",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "db:migrate": "pnpm --filter @cifradesk/database migrate",
    "admin:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "test:integration": "node --env-file=.local/identity-test.env scripts/run-local.mjs pnpm exec vitest run packages/infrastructure/src/identity.integration.test.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
