# Referência somente. Execute scripts/setup-local.mjs para gerar valores aleatórios locais.
COMPOSE_PROJECT_NAME=cifradesk-local
WEB_PORT=3200
MAILPIT_PORT=58025
POSTGRES_PASSWORD=
REDIS_CACHE_PASSWORD=
REDIS_QUEUE_PASSWORD=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Endereços internos previstos; não são credenciais de produção.
# PostgreSQL: postgres:5432 / database=cifradesk / user=cifradesk
# Redis de cache: redis-cache:6379; Redis de filas: redis-queue:6379
# S3: http://seaweedfs:8333; bucket futuro: cifradesk-local
# SMTP local: mailpit:1025; sem entrega externa

BETTER_AUTH_URL=http://localhost:3200
BETTER_AUTH_SECRET=
